{
  "name": "campus-fellow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "go run ./server/cmd/server",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vue-tsc --noEmit -p client/tsconfig.json && vite build --config client/vite.config.ts && go build -o server/bin/ ./server/cmd/server",
    "start": "go run ./server/cmd/server",
    "typecheck": "vue-tsc --noEmit -p client/tsconfig.json",
    "test:server": "go test ./server/...",
    "vet:server": "go vet ./server/...",
    "smoke": "go test ./server/internal/httpapi -run TestIntegration -count=1 -v -mysql"
  },
  "dependencies": {
    "lucide-vue-next": "^0.548.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vue-tsc": "^3.1.1"
  }
}
