PORT=3001
APP_ENV=development
# Create an empty MySQL 8.0+ database (utf8mb4) before starting.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_fellow
DB_USER=campus
DB_PASSWORD=
# Replace this placeholder with a random secret of at least 32 bytes.
JWT_SECRET=replace-this-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_DEMO=true
UPLOAD_DIR=server/uploads
CLIENT_DIST_DIR=client/dist

