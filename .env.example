PORT=3001
APP_ENV=development
# Create an empty MySQL 8.0+ database (utf8mb4) before starting.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_fellow
DB_USER=campus
DB_PASSWORD=
# Replace this placeholder with a random secret of at least 32 bytes.
JWT_SECRET=replace-this-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_DEMO=true
UPLOAD_DIR=server/uploads
CLIENT_DIST_DIR=client/dist

# Registration accepts exactly this mailbox domain; change it and restart the backend.
CAMPUS_EMAIL_DOMAIN=smail.nju.edu.cn
# Leave SMTP_HOST blank until ready; existing login works, new registrations require SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
# Provider authorization/app password, not necessarily your mailbox login password.
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME when omitted.
SMTP_FROM=
# Footer feedback (text + screenshots) is mailed here through the SMTP account above.
FEEDBACK_EMAIL=feedback@example.com

